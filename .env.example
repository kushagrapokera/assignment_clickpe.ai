# Local development configuration. Copy to .env and replace secrets.
# python3 scripts/configure.py generates a strong POSTGRES_PASSWORD.
POSTGRES_USER=loan_admin
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=loan_engine
TZ=Asia/Kolkata

# n8n public API (create the key in n8n: Settings -> n8n API).
N8N_API_URL=http://127.0.0.1:5678
N8N_API_KEY=

CRAWL4AI_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b

